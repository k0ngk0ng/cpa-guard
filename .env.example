# cpa-guard listens on the host network next to CPA and cpa-usage.
APP_PORT=8217
UPSTREAM_URL=http://127.0.0.1:8317

# Optional TOML model ACL (unlisted models allowed). Unset disables ACL.
# Use an absolute path; changes require a service restart.
# MODEL_ACL_FILE=/home/cliproxy/cpa-guard/model-acl.toml

# MAX_ATTEMPTS includes the initial request. The installer defaults to 100;
# values up to 500 are accepted. Keep MAX_ELAPSED_MS below the caller timeout.
MAX_ATTEMPTS=100
MAX_ELAPSED_MS=3300000

# Request replay and retry pacing.
MAX_BODY_BYTES=134217728
MEMORY_BODY_BYTES=2097152
INITIAL_BACKOFF_MS=250
MAX_BACKOFF_MS=5000
BACKOFF_JITTER=0.20
RETRY_AFTER_CAP_MS=60000
MAX_RESPONSE_DRAIN_BYTES=1048576
RETRY_STATUSES=502,503,504

# A zero header timeout allows long-running non-streaming model responses.
CONNECT_TIMEOUT_MS=10000
UPSTREAM_HEADER_TIMEOUT_MS=0
MAX_INFLIGHT=256

# Request bodies are spooled here and removed after the request finishes.
BODY_DIR=/home/cliproxy/cpa-guard/tmp
# Print safe request-body failure diagnostics (never logs body or auth headers).
DEBUG=false
METRICS_ENABLED=false
